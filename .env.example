# ============================================================
# FreelanceHub Pro — Environment Variables
# ============================================================
# Скопіюйте цей файл як .env та заповніть реальні значення.
# НЕ комітьте .env у репозиторій — він містить секретні ключі!
# ============================================================

# ── App ──────────────────────────────────────────────────────
APP_NAME=FreelanceHub Pro
APP_URL=https://your-domain.com
APP_SECRET=your_random_32_char_secret_here

# ════════════════════════════════════════════════════════════
# АВТЕНТИФІКАЦІЯ / EMAIL ВЕРИФІКАЦІЯ
# ════════════════════════════════════════════════════════════

# --- SMTP (стандартний поштовий сервер) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password

# --- Resend (рекомендовано: resend.com) ---
# Документація: https://resend.com/docs
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@your-domain.com
RESEND_FROM_NAME=FreelanceHub Pro

# --- Nodemailer (альтернатива) ---
# Використовуйте SMTP_ змінні вище з бібліотекою nodemailer

# OTP налаштування
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# ════════════════════════════════════════════════════════════
# КУРСИ ВАЛЮТ
# ════════════════════════════════════════════════════════════

# --- ExchangeRate-API (безкоштовний план: 1500 запитів/місяць) ---
# Реєстрація: https://www.exchangerate-api.com
EXCHANGERATE_API_KEY=your_exchangerate_api_key

# --- НБУ API (безкоштовно, без ключа, тільки UAH) ---
# Автоматично: https://bank.gov.ua/NBUStatService/v1/statdirectory/exchange?json
NBU_API_URL=https://bank.gov.ua/NBUStatService/v1/statdirectory/exchange?json

# Кешування курсів (хвилини)
EXCHANGE_RATE_CACHE_MINUTES=60

# ════════════════════════════════════════════════════════════
# ПЛАТІЖНІ ШЛЮЗИ
# ════════════════════════════════════════════════════════════

# Режим (true = тестовий sandbox, false = реальні платежі)
PAYMENT_SANDBOX_MODE=true

# Активний провайдер: wayforpay | liqpay | stripe | paypal | fondy | monobank
PAYMENT_PROVIDER=wayforpay

# --- WayForPay (Україна) ---
# Документація: https://wiki.wayforpay.com/en/view/852102
WAYFORPAY_MERCHANT_ACCOUNT=test_merch_n1
WAYFORPAY_MERCHANT_SECRET_KEY=flk3409refn54t54t*FNJRET
WAYFORPAY_API_URL=https://api.wayforpay.com/api

# --- LiqPay (Приватбанк) ---
# Документація: https://www.liqpay.ua/en/documentation/api
LIQPAY_PUBLIC_KEY=your_liqpay_public_key
LIQPAY_PRIVATE_KEY=your_liqpay_private_key
LIQPAY_SANDBOX=1

# --- Stripe (міжнародні платежі) ---
# Документація: https://stripe.com/docs/api
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- PayPal ---
# Документація: https://developer.paypal.com/docs/api/overview/
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox

# --- Fondy / MonoPay ---
# Документація: https://docs.fondy.eu/
FONDY_MERCHANT_ID=your_fondy_merchant_id
FONDY_SECRET_KEY=your_fondy_secret_key

# Webhook URL для підтвердження оплати
PAYMENT_WEBHOOK_URL=https://your-domain.com/api/webhook/payment

# ════════════════════════════════════════════════════════════
# AI / OCR
# ════════════════════════════════════════════════════════════

# --- OpenAI (GPT-4o Vision для OCR + Whisper для Voice) ---
# Документація: https://platform.openai.com/docs
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_WHISPER_MODEL=whisper-1

# --- Tesseract.js (клієнтський OCR, без ключа) ---
# Автоматично завантажується через CDN при першому використанні
# https://cdn.jsdelivr.net/npm/tesseract.js@5/dist/tesseract.min.js

# ════════════════════════════════════════════════════════════
# БАЗА ДАНИХ
# ════════════════════════════════════════════════════════════

# --- Supabase (PostgreSQL) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ════════════════════════════════════════════════════════════
# СПОВІЩЕННЯ
# ════════════════════════════════════════════════════════════

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=1234567890:AAXXXXXXXXXXXX
TELEGRAM_CHAT_ID=-100123456789

